--- /dev/null
+++ b/common/composed-sampler.h
@@ -0,0 +1,31 @@
+#pragma once
+
+// Composed decoding on the probability simplex (Khamis et al. 2026, arXiv 2609.34992):
+//
+//     q* = argmax_{q in simplex(support)}  <q, s>  -  lambda * sum_i alpha_i * Omega_i(q)
+//
+// s = logits / T over the support the earlier samplers left (top-k / top-p / min-p / ...), the base
+// distribution p = softmax(logits / base_temp) over that same support. Regularisers: kl_to_base,
+// js_to_base, entropy, coverage, diversity_gap. Solved in closed form where one exists (none -> argmax,
+// entropy only -> softmax(s / (lambda*alpha)), KL only -> softmax(log p + s / (lambda*alpha))) and by
+// exponentiated mirror ascent otherwise. The candidate logits are overwritten with log q*, so the
+// dist sampler that follows draws exactly q*.
+//
+// This sampler is meant to sit AFTER "temperature" in the chain: it receives logits already divided
+// by T and undoes that for the base distribution and the diversity gap, which the paper defines on the
+// raw supported logits.
+
+#include "common.h"
+
+#include <string>
+
+struct llama_sampler;
+
+// "kl:0.5,coverage:0.5:K=4:top_m=8"  ->  regularizers. Types: kl | js | entropy | coverage | diversity.
+// Global keys may be given as "lambda=1.0", "base_temp=1.0", "steps=10", "lr=0.1", "tol=0".
+bool common_composed_parse(const std::string & spec, common_composed_params & out, std::string & err);
+
+std::string common_composed_to_string(const common_composed_params & p);
+
+// temp is the temperature the chain applied before this sampler (1.0 if none)
+struct llama_sampler * common_sampler_init_composed(const common_composed_params & params, float temp);
