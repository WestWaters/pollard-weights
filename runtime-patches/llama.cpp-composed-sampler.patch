diff --git a/common/composed-sampler.cpp b/common/composed-sampler.cpp
new file mode 100644
index 000000000..03abda020
--- /dev/null
+++ b/common/composed-sampler.cpp
@@ -0,0 +1,308 @@
+#include "composed-sampler.h"
+
+#include "llama.h"
+#include "log.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+#include <sstream>
+#include <vector>
+
+// ---------------------------------------------------------------- spec parsing
+
+static bool parse_kv(const std::string & tok, std::string & k, std::string & v) {
+    const auto eq = tok.find('=');
+    if (eq == std::string::npos) {
+        return false;
+    }
+    k = tok.substr(0, eq);
+    v = tok.substr(eq + 1);
+    return true;
+}
+
+bool common_composed_parse(const std::string & spec, common_composed_params & out, std::string & err) {
+    out = common_composed_params{};
+    std::stringstream ss(spec);
+    std::string item;
+    while (std::getline(ss, item, ',')) {
+        if (item.empty()) {
+            continue;
+        }
+        std::string k, v;
+        if (parse_kv(item, k, v) && item.find(':') == std::string::npos) {
+            try {
+                if      (k == "lambda")    out.lambda    = std::stof(v);
+                else if (k == "base_temp") out.base_temp = std::stof(v);
+                else if (k == "steps")     out.steps     = std::stoi(v);
+                else if (k == "lr")        out.lr        = std::stof(v);
+                else if (k == "tol")       out.tol       = std::stof(v);
+                else { err = "unknown composed key: " + k; return false; }
+            } catch (...) {
+                err = "bad value for " + k + ": " + v; return false;
+            }
+            continue;
+        }
+        // type[:alpha[:key=val...]]
+        std::stringstream ps(item);
+        std::string part;
+        common_composed_regularizer r;
+        int idx = 0;
+        while (std::getline(ps, part, ':')) {
+            if (idx == 0) {
+                if      (part == "kl" || part == "kl_to_base")   r.type = "kl_to_base";
+                else if (part == "js" || part == "js_to_base")   r.type = "js_to_base";
+                else if (part == "entropy")                       r.type = "entropy";
+                else if (part == "coverage" || part == "cov")     r.type = "coverage";
+                else if (part == "diversity" || part == "div" || part == "diversity_gap") r.type = "diversity_gap";
+                else { err = "unknown regularizer: " + part; return false; }
+            } else if (idx == 1 && part.find('=') == std::string::npos) {
+                try { r.alpha = std::stof(part); } catch (...) { err = "bad alpha: " + part; return false; }
+            } else {
+                if (!parse_kv(part, k, v)) { err = "expected key=value in " + item; return false; }
+                try {
+                    if      (k == "alpha")       r.alpha       = std::stof(v);
+                    else if (k == "K")           r.K           = std::stoi(v);
+                    else if (k == "top_m")       r.top_m       = std::stoi(v);
+                    else if (k == "weight_mode") r.weight_mode = v;
+                    else if (k == "gap_tau")     r.gap_tau     = std::stof(v);
+                    else { err = "unknown regularizer key: " + k; return false; }
+                } catch (...) {
+                    err = "bad value for " + k + ": " + v; return false;
+                }
+            }
+            idx++;
+        }
+        out.regularizers.push_back(r);
+    }
+    if (out.regularizers.empty()) {
+        err = "composed spec names no regularizer";
+        return false;
+    }
+    return true;
+}
+
+std::string common_composed_to_string(const common_composed_params & p) {
+    std::ostringstream o;
+    for (size_t i = 0; i < p.regularizers.size(); ++i) {
+        const auto & r = p.regularizers[i];
+        if (i) o << ",";
+        o << r.type << ":" << r.alpha;
+        if (r.type == "coverage")      o << ":K=" << r.K << ":top_m=" << r.top_m << ":weight_mode=" << r.weight_mode;
+        if (r.type == "diversity_gap") o << ":K=" << r.K << ":gap_tau=" << r.gap_tau;
+    }
+    o << ",lambda=" << p.lambda << ",base_temp=" << p.base_temp << ",steps=" << p.steps << ",lr=" << p.lr << ",tol=" << p.tol;
+    return o.str();
+}
+
+// ---------------------------------------------------------------- the math (mirrors composimplex exactly)
+
+static const float EPS = 1e-8f;
+
+static void softmax_inplace(std::vector<float> & v) {
+    float mx = -INFINITY;
+    for (float x : v) mx = std::max(mx, x);
+    double sum = 0.0;
+    for (float & x : v) { x = expf(x - mx); sum += x; }
+    if (!(sum > 0.0) || !std::isfinite(sum)) {
+        std::fill(v.begin(), v.end(), 1.0f / (float) v.size());
+        return;
+    }
+    for (float & x : v) x = (float) (x / sum);
+}
+
+static std::vector<size_t> topm_indices(const std::vector<float> & ref, size_t m) {
+    std::vector<size_t> idx(ref.size());
+    std::iota(idx.begin(), idx.end(), 0);
+    m = std::min(m, ref.size());
+    std::partial_sort(idx.begin(), idx.begin() + m, idx.end(), [&](size_t a, size_t b) { return ref[a] > ref[b]; });
+    idx.resize(m);
+    return idx;
+}
+
+struct composed_ctx {
+    common_composed_params params;
+    float temp;
+    // scratch
+    std::vector<float> s, p, q, g, raw, w;
+};
+
+// gradient of  <q,s> - lambda * sum alpha_i Omega_i(q)   at q
+static void objective_grad(composed_ctx & c) {
+    const size_t n = c.q.size();
+    for (size_t i = 0; i < n; ++i) c.g[i] = c.s[i];
+    for (const auto & r : c.params.regularizers) {
+        const float coef = c.params.lambda * r.alpha;
+        if (r.type == "kl_to_base") {
+            for (size_t i = 0; i < n; ++i) {
+                const float qs = std::min(std::max(c.q[i], EPS), 1.0f), ps = std::min(std::max(c.p[i], EPS), 1.0f);
+                c.g[i] -= coef * (logf(qs / ps) + 1.0f);
+            }
+        } else if (r.type == "js_to_base") {
+            for (size_t i = 0; i < n; ++i) {
+                const float qs = std::min(std::max(c.q[i], EPS), 1.0f), ps = std::min(std::max(c.p[i], EPS), 1.0f);
+                const float m = std::min(std::max(0.5f * (ps + qs), EPS), 1.0f);
+                c.g[i] -= coef * (0.5f * logf(qs / m));
+            }
+        } else if (r.type == "entropy") {
+            for (size_t i = 0; i < n; ++i) {
+                const float qs = std::min(std::max(c.q[i], EPS), 1.0f);
+                c.g[i] -= coef * (logf(qs) + 1.0f);
+            }
+        } else if (r.type == "coverage" || r.type == "diversity_gap") {
+            // weights
+            std::fill(c.w.begin(), c.w.end(), 0.0f);
+            if (r.type == "coverage") {
+                const size_t m = std::min((size_t) std::max(r.top_m, 1), n);
+                if (r.weight_mode == "reference") {
+                    c.w = c.p;
+                } else {
+                    const auto idx = topm_indices(c.p, m);
+                    float val = 1.0f;
+                    if (r.weight_mode == "topm_l2") {
+                        val = 1.0f / sqrtf((float) m);
+                    } else if (r.weight_mode == "topm") {
+                        val = 1.0f;
+                    } else { // topm_uniform (default): uniform-distribution coverage of one
+                        const float max_hit = 1.0f - powf(1.0f - 1.0f / (float) m, (float) r.K);
+                        val = 1.0f / ((float) m * max_hit);
+                    }
+                    for (size_t i : idx) c.w[i] = val;
+                }
+            } else {
+                float mx = -INFINITY;
+                for (float x : c.raw) mx = std::max(mx, x);
+                const float tau = std::max(r.gap_tau, EPS);
+                double total = 0.0;
+                for (size_t i = 0; i < n; ++i) {
+                    const float gap = mx - c.raw[i];
+                    c.w[i] = gap * expf(-gap / tau);
+                    total += c.w[i];
+                }
+                if (std::isfinite(total) && total > 0.0) {
+                    for (size_t i = 0; i < n; ++i) c.w[i] = (float) (c.w[i] / total);
+                }
+            }
+            const float K = (float) r.K;
+            for (size_t i = 0; i < n; ++i) {
+                const float qc = (r.type == "coverage") ? std::min(std::max(c.q[i], EPS), 1.0f) : c.q[i];
+                const float one_minus = std::min(std::max(1.0f - qc, 0.0f), 1.0f);
+                const float cov_grad = K * powf(one_minus, K - 1.0f);
+                // Omega = -coverage  ->  grad Omega = -(w * cov_grad);  g -= coef * gradOmega  ->  g += coef*w*cov_grad
+                c.g[i] += coef * c.w[i] * cov_grad;
+            }
+        }
+    }
+}
+
+static void solve(composed_ctx & c) {
+    const size_t n = c.s.size();
+    const auto & P = c.params;
+    const auto & R = P.regularizers;
+
+    bool only_entropy = !R.empty(), only_kl = !R.empty();
+    float a_ent = 0.0f, a_kl = 0.0f;
+    for (const auto & r : R) {
+        if (r.type != "entropy")    only_entropy = false; else a_ent += r.alpha;
+        if (r.type != "kl_to_base") only_kl      = false; else a_kl  += r.alpha;
+    }
+
+    if (R.empty() || P.lambda == 0.0f) {                 // argmax <q,s>: one-hot
+        size_t best = 0;
+        for (size_t i = 1; i < n; ++i) if (c.s[i] > c.s[best]) best = i;
+        std::fill(c.q.begin(), c.q.end(), 0.0f);
+        c.q[best] = 1.0f;
+        return;
+    }
+    if (only_entropy) {
+        const float strength = std::max(P.lambda * a_ent, EPS);
+        for (size_t i = 0; i < n; ++i) c.q[i] = c.s[i] / strength;
+        softmax_inplace(c.q);
+        return;
+    }
+    if (only_kl) {
+        const float strength = std::max(P.lambda * a_kl, EPS);
+        for (size_t i = 0; i < n; ++i) c.q[i] = logf(std::max(c.p[i], EPS)) + c.s[i] / strength;
+        softmax_inplace(c.q);
+        return;
+    }
+    // mirror ascent from q0 = p
+    for (size_t i = 0; i < n; ++i) c.q[i] = std::max(c.p[i], EPS);
+    { double t = 0; for (float x : c.q) t += x; for (float & x : c.q) x = (float) (x / t); }
+    std::vector<float> q0 = c.q;
+    for (int step = 0; step < P.steps; ++step) {
+        objective_grad(c);
+        float gmax = -INFINITY; double qg = 0.0; bool finite = true;
+        for (size_t i = 0; i < n; ++i) { if (!std::isfinite(c.g[i])) finite = false; gmax = std::max(gmax, c.g[i]); qg += (double) c.q[i] * c.g[i]; }
+        if (!finite) { c.q = q0; return; }
+        if (P.tol > 0.0f && (gmax - qg) <= P.tol) break;
+        double total = 0.0;
+        for (size_t i = 0; i < n; ++i) {
+            const float upd = expf(P.lr * (c.g[i] - gmax));
+            c.q[i] = std::max(c.q[i] * upd, EPS);
+            total += c.q[i];
+        }
+        if (!std::isfinite(total) || total <= 0.0) { c.q = q0; return; }
+        for (float & x : c.q) x = (float) (x / total);
+    }
+}
+
+// ---------------------------------------------------------------- llama_sampler glue
+
+static const char * composed_name(const struct llama_sampler *) { return "composed"; }
+
+static void composed_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * c = (composed_ctx *) smpl->ctx;
+    const size_t n = cur_p->size;
+    if (n == 0 || c->params.regularizers.empty()) {
+        return;
+    }
+    const float T = (c->temp > 0.0f) ? c->temp : 1.0f;
+    const float bt = std::max(c->params.base_temp, 1e-6f);
+    c->s.resize(n); c->p.resize(n); c->q.resize(n); c->g.resize(n); c->raw.resize(n); c->w.resize(n);
+    for (size_t i = 0; i < n; ++i) {
+        c->s[i]   = cur_p->data[i].logit;          // already / T by the temperature sampler
+        c->raw[i] = cur_p->data[i].logit * T;      // the raw supported logit the paper's terms are defined on
+        c->p[i]   = c->raw[i] / bt;
+    }
+    softmax_inplace(c->p);
+    solve(*c);
+    for (size_t i = 0; i < n; ++i) {
+        const float q = std::max(c->q[i], EPS);
+        cur_p->data[i].p     = q;
+        cur_p->data[i].logit = logf(q);
+    }
+    cur_p->sorted = false;
+}
+
+static struct llama_sampler * composed_clone(const struct llama_sampler * smpl) {
+    const auto * c = (const composed_ctx *) smpl->ctx;
+    return common_sampler_init_composed(c->params, c->temp);
+}
+
+static void composed_free(struct llama_sampler * smpl) {
+    delete (composed_ctx *) smpl->ctx;
+}
+
+static struct llama_sampler_i composed_i = {
+    /* .name              = */ composed_name,
+    /* .accept            = */ nullptr,
+    /* .apply             = */ composed_apply,
+    /* .reset             = */ nullptr,
+    /* .clone             = */ composed_clone,
+    /* .free              = */ composed_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ nullptr,
+};
+
+struct llama_sampler * common_sampler_init_composed(const common_composed_params & params, float temp) {
+    auto * c = new composed_ctx{};
+    c->params = params;
+    c->temp   = temp;
+    return llama_sampler_init(&composed_i, c);
+}
