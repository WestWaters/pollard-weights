+#include <cstdint>
+#include <vector>
+#include <ATen/Tensor.h>
+#include "avx2_target.h"
+#include "avx512_target.h"
+#include "cpu/moe_mul1.h"
+#include "parallel/all_reduce_cpu_avx2.h"
+#include "parallel/all_reduce_cpu_avx512.h"
+static void _na(const char* f) { throw std::runtime_error(std::string(f) + ": x86 CPU path not available on this architecture (aarch64 build)"); }
+bool is_avx2_supported() { return false; }
+bool is_f16c_supported() { return false; }
+bool is_avx512_supported() { return false; }
+bool exl3_moe_cpu_has_avx2() { return false; }
+bool exl3_moe_cpu_has_avx512_vnni() { return false; }
+bool exl3_moe_cpu_has_avx512_vbmi() { return false; }
+void exl3_moe_cpu_set_prof(bool) {}
+int64_t exl3_moe_cpu_pool_stress(int, int, int, int) { return 0; }
+int64_t exl3_moe_cpu_make_layer(const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    const std::vector<at::Tensor>&, const std::vector<at::Tensor>&, const std::vector<at::Tensor>&,
+    int64_t, double, int64_t) { _na("exl3_moe_cpu_make_layer"); return -1; }
+void exl3_moe_cpu_free_layer(int64_t) {}
+void exl3_moe_cpu_forward(int64_t, const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&, int64_t) { _na("exl3_moe_cpu_forward"); }
+void exl3_moe_cpu_forward_raw(int64_t, const at::Half*, const int32_t*, const at::Half*, float*, int, int, int) { _na("exl3_moe_cpu_forward_raw"); }
+void exl3_moe_cpu_stage_experts(int64_t, const uint32_t*, int, uint8_t*, int) { _na("exl3_moe_cpu_stage_experts"); }
+void enable_fast_fp() {}
+void enable_fast_fp_avx2() {}
+void enable_fast_fp_avx512() {}
+void perform_cpu_reduce(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { _na("perform_cpu_reduce"); }
+void perform_cpu_reduce_avx2(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { _na("perform_cpu_reduce_avx2"); }
+void perform_cpu_reduce_avx512(PGContext*, size_t, uint32_t, uint32_t, uint8_t*, size_t) { _na("perform_cpu_reduce_avx512"); }
+void cpu_reduce_parallel(void (*)(uint16_t*, const uint16_t*, const uint16_t*, size_t), void (*)(uint16_t*, const uint16_t*, size_t),
+    uint16_t*, const uint16_t*, const uint16_t*, size_t, int) { _na("cpu_reduce_parallel"); }
+void bf16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t) { _na("bf16_add_inplace_avx512"); }
+void bf16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t) { _na("bf16_add_twosrc_avx512"); }
+void fp16_add_inplace_avx512(uint16_t*, const uint16_t*, size_t) { _na("fp16_add_inplace_avx512"); }
+void fp16_add_twosrc_avx512(uint16_t*, const uint16_t*, const uint16_t*, size_t) { _na("fp16_add_twosrc_avx512"); }
